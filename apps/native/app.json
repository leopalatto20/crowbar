{
  "expo": {
    "name": "crowbar",
    "slug": "crowbar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crowbar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.crowbar",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Crowbar Routine",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.anonymous.crowbar.routine"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.anonymous.crowbar.routine",
            "UTTypeDescription": "Crowbar Routine",
            "UTTypeConformsTo": ["public.data", "public.content"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["crowbar-routine"],
              "public.mime-type": ["application/vnd.crowbar.routine"]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B1B1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.crowbar",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "scheme": "content", "mimeType": "application/vnd.crowbar.routine" },
            { "scheme": "file", "mimeType": "application/vnd.crowbar.routine" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "content",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\\\.crowbar-routine"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\\\.crowbar-routine"
            }
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/with-ios-entitlements",
      "./plugins/with-ios-scene-lifecycle",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "es"],
          "allowDynamicLocaleChangesAndroid": true
        }
      ],
      "expo-sqlite",
      "./plugins/with-android-notification-icon",
      "expo-widgets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
