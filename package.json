{
  "name": "crowbar",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:native": "bun run --filter native dev",
    "check": "oxlint && oxfmt --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@crowbar/config": "workspace:*",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.14"
}
