{
  "name": "crowbar",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/html-elements": "^0.12.5",
    "@expo/ui": "~57.0.19",
    "@gluestack-ui/core": "^5.0.0-alpha.0",
    "@gluestack-ui/utils": "^5.0.1-alpha.0",
    "@legendapp/motion": "^2.4.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "nativewind": "^5.0.0-preview.2",
    "react": "19.2.3",
    "react-aria": "^3.45.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-stately": "^3.39.0",
    "tailwind-variants": "^0.1.20",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^4.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint src",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "doctor": "npx react-doctor@latest"
  },
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"],
    "transformIgnorePatterns": [
      "node_modules/(?!(.bun|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@gluestack-ui|nativewind))"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!src/testing/**",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/expo-env.d.ts"
    ],
    "coverageThreshold": {
      "./src/features/exercise-catalog/": {
        "branches": 90,
        "lines": 90
      },
      "./src/features/exercise-catalog/model/custom-exercise.ts": {
        "branches": 100
      },
      "./src/features/exercise-catalog/data/builtin-exercises.ts": {
        "branches": 100
      },
      "./src/features/exercise-catalog/model/catalog-selectors.ts": {
        "branches": 100
      },
      "./src/features/training-preferences/": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
