{
  "name": "crowbar",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/native dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types && tsc --noEmit -p scripts",
    "check": "oxlint && oxfmt --write && bun run check-raw-sql",
    "check-raw-sql": "bun scripts/check-raw-sql.ts",
    "test": "bun test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@crowbar/config": "workspace:*",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "apps/native/db/**/*.{ts,tsx}": "bun scripts/check-raw-sql.ts"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
}
