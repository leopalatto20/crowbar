{
  "expo": {
    "name": "crowbar",
    "slug": "crowbar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "crowbar",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
